worker_processes  1;

#error_log  logs/error.log;
#error_log  logs/error.log  notice;
#error_log  logs/error.log  info;

#pid        logs/nginx.pid;


events {
    worker_connections  1024;
}


http {
    include       mime.types;
    default_type  application/octet-stream;

    #log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
    #                  '$status $body_bytes_sent "$http_referer" '
    #                  '"$http_user_agent" "$http_x_forwarded_for"';

    #access_log  logs/access.log  main;

    sendfile        on;
    #tcp_nopush     on;

    keepalive_timeout  65;

    # Rate limit for the public fortune endpoints (anonymous users allowed)
    limit_req_zone $binary_remote_addr zone=fortune:10m rate=5r/s;

    server {
        listen       8000;
        server_name  ${GATEWAY_SERVER_NAME};

        #access_log  logs/host.access.log  main;
        proxy_ssl_server_name on;
        add_header "Access-Control-Allow-Origin" "*" always;
        add_header "Access-Control-Allow-Headers" "Content-Type,Accept,Accept-Language,authorization" always;

        if ($request_method = "OPTIONS") {
          return 204;
        }

        #Authentication
        location = /authentication {
          internal;
          proxy_pass ${MAIN_SERVICE_URL}/api/auth/is-logged-in;
          proxy_pass_request_body off;
          proxy_pass_request_headers off;
          proxy_set_header Content-Length "";
          proxy_set_header Authorization $http_authorization;
        }

        # Websocket service
        location /comment-svc/ws {
          proxy_pass ${COMMENT_SERVICE_URL};
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection "upgrade";
        }

        # Satellite service
        location = /comment-svc/api/comments {
          if ($request_method = "POST") {
            rewrite ^(.*) $1.proteced;
          }

          # Never trust a client-sent user header
          proxy_set_header X-User-Info "";
          proxy_pass ${COMMENT_SERVICE_URL};
        }

        # Protected Satellite service
        location = /comment-svc/api/comments.proteced {
          auth_request /authentication;
          auth_request_set $auth_user $upstream_http_x_user_info;
          rewrite ^(.*).proteced $1 break;
          proxy_pass ${COMMENT_SERVICE_URL};
          proxy_set_header X-User-Info $auth_user;
          internal;
        }

        # Protected fortune data (saved profiles and reading history)
        location /comment-svc/api/fortune/me/ {
          auth_request /authentication;
          error_page 401 = @unauthorized_json;
          auth_request_set $auth_user $upstream_http_x_user_info;
          proxy_set_header X-User-Info $auth_user;
          proxy_pass ${COMMENT_SERVICE_URL};
        }

        # JSON 401 in the {meta} envelope the frontend expects
        location @unauthorized_json {
          default_type application/json;
          return 401 '{"meta":{"ok":false,"message":"Vui lòng đăng nhập!"}}';
        }

        location @too_many_requests_json {
          default_type application/json;
          return 429 '{"meta":{"ok":false,"message":"Bạn thao tác quá nhanh, vui lòng thử lại sau giây lát."}}';
        }

        # Public fortune compute endpoints: anonymous allowed, rate limited
        location /comment-svc/api/fortune/ {
          limit_req zone=fortune burst=20 nodelay;
          limit_req_status 429;
          error_page 429 = @too_many_requests_json;
          proxy_set_header X-User-Info "";
          proxy_pass ${COMMENT_SERVICE_URL};
        }

        # Satellite service
        location /comment-svc/api {
          # Never trust a client-sent user header: the comment service
          # reads it as the logged-in user
          proxy_set_header X-User-Info "";
          proxy_pass ${COMMENT_SERVICE_URL};
        }

        # Main service
        location / {
          proxy_pass ${MAIN_SERVICE_URL};
        }

        #error_page  404              /404.html;

        # redirect server error pages to the static page /50x.html
        #
        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   html;
        }

        # proxy the PHP scripts to Apache listening on 127.0.0.1:80
        #
        #location ~ \.php$ {
        #    proxy_pass   http://127.0.0.1;
        #}

        # pass the PHP scripts to FastCGI server listening on 127.0.0.1:9000
        #
        #location ~ \.php$ {
        #    root           html;
        #    fastcgi_pass   127.0.0.1:9000;
        #    fastcgi_index  index.php;
        #    fastcgi_param  SCRIPT_FILENAME  /scripts$fastcgi_script_name;
        #    include        fastcgi_params;
        #}

        # deny access to .htaccess files, if Apache's document root
        # concurs with nginx's one
        #
        #location ~ /\.ht {
        #    deny  all;
        #}
    }


